{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar servidor do jogo",
            "type": "shell",
            "command": "python3 -m http.server 8080",
            "options": {
                "cwd": "${workspaceFolder}/Versão Web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*"
                }
            }
        }
    ]
}